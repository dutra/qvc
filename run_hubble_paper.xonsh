#!/usr/bin/env xonsh

from pathlib import Path

# Environment variables (xonsh style)
$QT_QPA_PLATFORM = "offscreen"
$NUM_CORES = "30"
$PYTHONPATH = str(Path(__file__).resolve().parent / "src")

speed = "production"
python_cmd = "python"
magnitude_convention = __xonsh__.env["QVC_HUBBLE_MAGNITUDE_CONVENTION"]

spectra_fit_csv = "results/data/jul29_2206_9dad47e_sedfit.csv"
h5_file = "results/data/lc_data_all.h5"

base_prefix = f"paper_may2a_apr23lc_apr19bspec_{speed}"
fiducial_prefix = base_prefix
restricted_prefix = f"{base_prefix}_restricted"

$PREFIX = fiducial_prefix
prefix = fiducial_prefix
echo "Running hubble_fit.py and PREFIX=" $PREFIX

@(python_cmd) -m qvc.hubble.hubble_fit --resume \
    --cosmo_models FlatLambdaCDM FlatwCDM Flatw0waCDM \
    --run full \
    --speed @(speed) \
    --spectra_fit_csv @(spectra_fit_csv) \
    --magnitude-convention @(magnitude_convention) \
    --z_range 0.44 3.16 \
    --result_prefix "fiducial" \
    --prefix @(prefix) \
    --sigma_clip_threshold 3.0 \
    @(h5_file)
    

$PREFIX = restricted_prefix
prefix = restricted_prefix
echo "Running hubble_fit.py and PREFIX=" $PREFIX

@(python_cmd) -m qvc.hubble.hubble_fit --resume \
    --cosmo_models FlatLambdaCDM FlatwCDM Flatw0waCDM \
    --run full \
    --speed @(speed) \
    --spectra_fit_csv @(spectra_fit_csv) \
    --magnitude-convention @(magnitude_convention) \
    --z_range 1.0 3.16 \
    --result_prefix "restricted" \
    --prefix @(prefix) \
    --sigma_clip_threshold 3.0 \
    @(h5_file)

bash scripts/copy_paper_assets.sh \
    --speed @(speed) \
    --fiducial-dir @(f"plots/hubble/{fiducial_prefix}") \
    --restricted-dir @(f"plots/hubble/{restricted_prefix}")
