#!/usr/bin/env xonsh

# Environment variables (xonsh style)
$QT_QPA_PLATFORM = "offscreen"
$NUM_CORES = "30"

speed = "production"

spectra_fit_csv = "results/data/jaxqsofit_apr20c_chisq20_apr18h_all_run2d.csv"
h5_file = "results/data/apr23_1148am_6159c97_chisq.h5"

$PREFIX = f"paper_may2a_apr23lc_apr19bspec_{speed}"
prefix = $PREFIX
echo "Running hubble_fit.py and PREFIX=" $PREFIX

python -m qvc.hubble.hubble_fit \
    --cosmo_models FlatLambdaCDM FlatwCDM Flatw0waCDM \
    --run full \
    --speed @(speed) \
    --spectra_fit_csv @(spectra_fit_csv) \
    --z_range 0.44 3.16 \
    --result_prefix "fiducial" \
    --prefix @(prefix) \
    --sigma_clip_threshold 3.0 \
    @(h5_file)
    

$PREFIX = $PREFIX + "_restricted"
prefix = $PREFIX

python -m qvc.hubble.hubble_fit \
    --cosmo_models FlatLambdaCDM FlatwCDM Flatw0waCDM \
    --run full \
    --speed @(speed) \
    --spectra_fit_csv @(spectra_fit_csv) \
    --z_range 1.0 3.16 \
    --result_prefix "restricted" \
    --prefix @(prefix) \
    --sigma_clip_threshold 3.0 \
    @(h5_file)
    