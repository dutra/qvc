#!/usr/bin/env xonsh

from pathlib import Path

# Optional interactive prompt customization is intentionally omitted so this
# batch runner does not depend on the external ``cmd_done`` xontrib.

# Environment variables (xonsh style)
$QT_QPA_PLATFORM = "offscreen"
$NUM_CORES = "26"
$JAX_NUM_CPU_DEVICES = "26"
hubble_cpu_set = "0-13,16-29"
hubble_nice_level = "10"

# Dynesty parallelizes across processes. Keep every worker's native numerical
# libraries single-threaded; otherwise NUM_CORES workers each create a full
# machine-sized BLAS/OpenMP pool and can spend most of their time contending.
$OMP_NUM_THREADS = "1"
$OPENBLAS_NUM_THREADS = "1"
$MKL_NUM_THREADS = "1"
$NUMEXPR_NUM_THREADS = "1"
$PYTHONPATH = str(Path(__file__).resolve().parent / "src")
$MPLCONFIGDIR = "/tmp/qvc-matplotlib"
$SHEN_PUBTOOLS_PATH = __xonsh__.env.get(
    "SHEN_PUBTOOLS_PATH",
    str(Path.home() / "sdev" / "quasarlf" / "pubtools"),
)

# Hubble quality cuts used for the conservative completeness-smoothing test.
# Keep the category-specific R-hat variables: QVC_CUT_MCMC_RHAT_MAX has been
# retired and is intentionally not used here.
$QVC_CUT_SPECTRAL_RHAT_MAX = __xonsh__.env.get("QVC_CUT_SPECTRAL_RHAT_MAX", "1.1")
$QVC_CUT_LIGHT_CURVE_RHAT_MAX = __xonsh__.env.get("QVC_CUT_LIGHT_CURVE_RHAT_MAX", "1.1")
$QVC_CUT_NUM_DIVERGENCES_MAX = __xonsh__.env.get(
    "QVC_CUT_NUM_DIVERGENCES_MAX", "none"
)
$QVC_CUT_LOG_TAU_UV_RF_MIN = __xonsh__.env.get(
    "QVC_CUT_LOG_TAU_UV_RF_MIN", "1.5"
)
$QVC_CUT_LOG_TAU_UV_RF_MAX = __xonsh__.env.get("QVC_CUT_LOG_TAU_UV_RF_MAX", "4.0")
$QVC_CUT_T_RF_OVER_TAU_UV_RF_MIN = __xonsh__.env.get(
    "QVC_CUT_T_RF_OVER_TAU_UV_RF_MIN", "0"
)
$QVC_CUT_VARIABILITY_CHI_SQ_RED_G_MIN = __xonsh__.env.get(
    "QVC_CUT_VARIABILITY_CHI_SQ_RED_G_MIN", "20"
)
$QVC_CUT_LOG_SIGMA_UV_MIN = __xonsh__.env.get("QVC_CUT_LOG_SIGMA_UV_MIN", None)
$QVC_CUT_LOG_SIGMA_UV_MAX = __xonsh__.env.get("QVC_CUT_LOG_SIGMA_UV_MAX", None)
$QVC_CUT_LIGHT_CURVE_N_POINTS_MIN = __xonsh__.env.get(
    "QVC_CUT_LIGHT_CURVE_N_POINTS_MIN", "250"
)
$QVC_CUT_APPARENT_MAG_2500_ERR_MAX = __xonsh__.env.get("QVC_CUT_APPARENT_MAG_2500_ERR_MAX", "0.5")
$QVC_CUT_SED_REDUCED_CHI2_MAX = __xonsh__.env.get("QVC_CUT_SED_REDUCED_CHI2_MAX", "5.0")
$QVC_CUT_SPECTROSCOPY_REDUCED_CHI2_MAX = __xonsh__.env.get("QVC_CUT_SPECTROSCOPY_REDUCED_CHI2_MAX", "1.5")
$QVC_CUT_JAXSEDFIT_JOINT_REDUCED_CHI2_MAX = __xonsh__.env.get("QVC_CUT_JAXSEDFIT_JOINT_REDUCED_CHI2_MAX", "1.5")
$QVC_CUT_LOO_CHI2_EFF_MAX = __xonsh__.env.get("QVC_CUT_LOO_CHI2_EFF_MAX", "1.5")

# Conservative 2D completeness-map smoothing (mag, z).  These override the
# shared defaults for this runner and match the retained Hubble-diagram test.
$QVC_HUBBLE_COMPLETENESS_SMOOTH_SIGMA_MAG = __xonsh__.env.get("QVC_HUBBLE_COMPLETENESS_SMOOTH_SIGMA_MAG", "0.10")
$QVC_HUBBLE_COMPLETENESS_SMOOTH_SIGMA_Z = __xonsh__.env.get("QVC_HUBBLE_COMPLETENESS_SMOOTH_SIGMA_Z", "0.30")

# Previous relaxed thresholds; uncomment the relevant line above and comment
# its active counterpart to quickly restore it for a comparison run.
# $QVC_CUT_LIGHT_CURVE_RHAT_MAX = "1.10"
# $QVC_CUT_NUM_DIVERGENCES_MAX = "none"
# $QVC_CUT_LOG_TAU_UV_RF_MIN = "none"
# $QVC_CUT_LOG_TAU_UV_RF_MAX = "4.0"
# $QVC_CUT_T_RF_OVER_TAU_UV_RF_MIN = "none"
# $QVC_CUT_VARIABILITY_CHI_SQ_RED_G_MIN = "none"
# $QVC_CUT_LOG_SIGMA_UV_MIN = "none"
# $QVC_CUT_LOG_SIGMA_UV_MAX = "none"
# $QVC_CUT_LIGHT_CURVE_N_POINTS_MIN = "none"
# $QVC_CUT_APPARENT_MAG_2500_ERR_MAX = "1.0"
# $QVC_CUT_SED_REDUCED_CHI2_MAX = "none"
# $QVC_CUT_SPECTROSCOPY_REDUCED_CHI2_MAX = "none"
# $QVC_CUT_JAXSEDFIT_JOINT_REDUCED_CHI2_MAX = "1.5"
# $QVC_CUT_LOO_CHI2_EFF_MAX = "none"
# $QVC_CUT_A_2500_TOTAL_MAX = "0.25"
# $QVC_HUBBLE_COMPLETENESS_SMOOTH_SIGMA_MAG = "0.20"
# $QVC_HUBBLE_COMPLETENESS_SMOOTH_SIGMA_Z = "0.20"

# Sweep values fastest, quick, standard.  The environment overrides make this
# runner suitable for isolated, reproducible cut-search members.
speed = __xonsh__.env.get("QVC_HUBBLE_SPEED", "quick")
magnitude_convention = __xonsh__.env.get("QVC_HUBBLE_MAGNITUDE_CONVENTION", "dereddened")
completeness_magnitude = __xonsh__.env.get(
    "QVC_HUBBLE_COMPLETENESS_MAGNITUDE", "attenuated"
)
spectra_sdss_run2d = __xonsh__.env.get(
    "QVC_HUBBLE_SPECTRA_SDSS_RUN2D", "all"
)
sdss_target_selection = __xonsh__.env.get(
    "QVC_HUBBLE_SDSS_TARGET_SELECTION", "all"
)
completeness_stratification = __xonsh__.env.get(
    "QVC_HUBBLE_COMPLETENESS_STRATIFICATION", "none"
)
completeness_mode = __xonsh__.env.get("QVC_HUBBLE_COMPLETENESS_MODE", "old")
color_artifact = __xonsh__.env.get("QVC_COLOR_COMPLETENESS_ARTIFACT", "").strip()
color_artifact_args = (
    ["--color-completeness-artifact", color_artifact]
    if color_artifact
    else []
)
color_support_cut = __xonsh__.env.get(
    "QVC_HUBBLE_COLOR_SUPPORT_CUT", "false"
).lower() in {"1", "true", "yes", "on"}
color_support_cut_args = ["--color-support-cut"] if color_support_cut else []
completeness_lf_model = __xonsh__.env.get(
    "QVC_HUBBLE_COMPLETENESS_LF_MODEL", "wang2026_type1_lade_a"#"shen"
).strip()
completeness_sim_file = __xonsh__.env.get(
    "QVC_HUBBLE_COMPLETENESS_SIM_FILE", ""
).strip()
completeness_sim_args = (
    ["--completeness_sim_file", completeness_sim_file]
    if completeness_sim_file
    else []
)
completeness_mock_oversample = __xonsh__.env.get(
    "QVC_HUBBLE_COMPLETENESS_MOCK_OVERSAMPLE",
    "4",
)
completeness_mock_max_rows = __xonsh__.env.get(
    "QVC_HUBBLE_COMPLETENESS_MOCK_MAX_ROWS", "2000000"
)
completeness_mock_proposal_area = __xonsh__.env.get(
    "QVC_HUBBLE_COMPLETENESS_MOCK_PROPOSAL_AREA", "full_sky"
)
dynesty_seed = __xonsh__.env.get("QVC_HUBBLE_DYNESTY_SEED", "12345")
allow_spectra_catalog_v1 = __xonsh__.env.get(
    "QVC_HUBBLE_ALLOW_SPECTRA_CATALOG_V1", "false"
).lower() in {"1", "true", "yes", "on"}
allow_spectra_catalog_v1_args = (
    ["--allow-spectra-catalog-v1"] if allow_spectra_catalog_v1 else []
)
allow_spectra_catalog_v2 = __xonsh__.env.get(
    "QVC_HUBBLE_ALLOW_SPECTRA_CATALOG_V2", "false"
).lower() in {"1", "true", "yes", "on"}
allow_spectra_catalog_v2_args = (
    ["--allow-spectra-catalog-v2"] if allow_spectra_catalog_v2 else []
)
completeness_closure_test = __xonsh__.env.get(
    "QVC_HUBBLE_COMPLETENESS_CLOSURE_TEST", "true"
).lower() in {"1", "true", "yes", "on"}
completeness_closure_args = (
    ["--completeness-closure-test"] if completeness_closure_test else []
)
z_min = __xonsh__.env.get("QVC_HUBBLE_Z_MIN", "0.44")
z_max = __xonsh__.env.get("QVC_HUBBLE_Z_MAX", "3.16")
resume_checkpoint = __xonsh__.env.get("QVC_HUBBLE_RESUME", "")
resume_args = ["--resume", resume_checkpoint] if resume_checkpoint else []
no_cuts = __xonsh__.env.get("QVC_HUBBLE_NO_CUTS", "false").lower() in {
    "1", "true", "yes", "on"
}
no_cuts_args = ["--no-cuts"] if no_cuts else []
minimal_plots = __xonsh__.env.get("QVC_HUBBLE_MINIMAL_PLOTS", "true").lower() in {
    "1", "true", "yes", "on"
}
minimal_plots_args = ["--minimal-plots"] if minimal_plots else []

h5_file = "results/data/lc_data_all.h5"

#h5_file = "results/data/lc_data_all_aug06_0115_f2b677d_N4000_BOSS_20260817.h5"
#h5_file = "results/data/aug17_0501am_erlang_preview_chisq_legacy_n4000_boss_f2b677d_chisq.h5"
#spectra_fit_h5 = "results/data/jul29_2206_9dad47e_sedfit.h5"

#h5_file = "results/data/aug18_0955pm_erlang_preview_chisq_nofluxguard_n8000_ebdef2a_chisq.h5"
#spectra_fit_h5 = "results/data/jul29_2206_9dad47e_sedfit.h5"
#spectra_fit_h5 = "results/data/aug17_0205pm_spectrafit_090df0c_nested_N8000.h5"
#h5_file = "results/data/aug16_0611am_mag_linear_svi4000w2000s500_f978995_stone.h5"

#spectra_fit_h5 = "results/data/aug20_0955am_spectrafit_1738e97_stone_svi4000lr001w500s250_chunk1.h5"
#h5_file = "results/data/aug19_1037pm_mag_linear_svi4000w2000s500_c3ce4ce_stone_nolinear.h5"

spectra_fit_h5 = "results/data/jaxqsofit/aug24_0152pm_spectrafit_e5d2897_chisqgt20_N8000_nested_fhostpsf_resumed_m2500norm12_v3.h5"
#h5_file = "results/data/aug22_0346pm_mag_linear_svi4000w2000s500_stonechisq_specaug210827am_n8000_af3ff4c_chisq.h5"
#h5_file = "results/data/aug23_1002am_erlang_legacy_svithennuts_psfmedian_svi4000w250s250_stonechisq_specaug230925am_n8000_dd61211_chisq.h5"
#h5_file = "results/data/aug23_1256pm_erlang_legacy_svithennuts_psflogitnormal_iters3_svi4000w250s250_stonechisq_specaug230925am_n8000_dd61211_chisq.h5"
#h5_file = "results/data/aug26_1200am_erlang_dho_svithennuts_psflogitnormal_iters1_svi4000w250s250_stonechisq_specaug240152pm_n8000_e5d2897_chisq.h5"
h5_file = "results/data/aug27_1219pm_erlang_legacy_svithennuts_psflogitnormal_iters3_svi4000w250s250_stonechisq_specaug240152pmv3_n8000_536f607_chisq.h5"
spectra_fit_h5 = __xonsh__.env.get(
    "QVC_HUBBLE_SPECTRA_FIT_H5", spectra_fit_h5
)
sdss_target_metadata_h5 = __xonsh__.env.get(
    "QVC_HUBBLE_SDSS_TARGET_METADATA_H5", ""
).strip()
sdss_target_metadata_args = (
    ["--sdss-target-metadata-h5", sdss_target_metadata_h5]
    if sdss_target_metadata_h5 else []
)
h5_file = __xonsh__.env.get("QVC_HUBBLE_LIGHT_CURVE_H5", h5_file)

$PREFIX = __xonsh__.env.get(
    "QVC_HUBBLE_PREFIX",
    f"aug27d_erlanglegacy_lcv3_4k_minpoints250_rho0_wadetypeladea_dereddened_cutstight_n8000_{speed}",
)

prefix = $PREFIX
echo "Running hubble_fit.py and PREFIX=" $PREFIX
echo "CPU workers/devices: 26; affinity:" @(hubble_cpu_set) \
    "; nice level:" @(hubble_nice_level)

taskset --cpu-list @(hubble_cpu_set) nice --adjustment @(hubble_nice_level) \
    python -m qvc.hubble.hubble_fit \
    @(resume_args) \
    --cosmo_models Flatw0waCDM \
    --run single \
    --speed @(speed) \
    --spectra_fit_h5 @(spectra_fit_h5) \
    @(sdss_target_metadata_args) \
    --spectra_sdss_run2d @(spectra_sdss_run2d) \
    --sdss-target-selection @(sdss_target_selection) \
    --completeness-stratification @(completeness_stratification) \
    --completeness-mode @(completeness_mode) \
    @(color_artifact_args) \
    @(color_support_cut_args) \
    --completeness-lf-model @(completeness_lf_model) \
    @(completeness_sim_args) \
    --completeness-mock-oversample @(completeness_mock_oversample) \
    --completeness-mock-max-rows @(completeness_mock_max_rows) \
    --completeness-mock-proposal-area @(completeness_mock_proposal_area) \
    --dynesty-seed @(dynesty_seed) \
    @(allow_spectra_catalog_v1_args) \
    @(allow_spectra_catalog_v2_args) \
    --magnitude-convention @(magnitude_convention) \
    --completeness_magnitude @(completeness_magnitude) \
    --result_prefix "fiducial" \
    --z_range @(z_min) @(z_max) \
    --prefix @(prefix) \
    --disable_sigma_clip_pass \
    --sigma_clip_threshold 3.0 \
    @(completeness_closure_args) \
    @(no_cuts_args) \
    @(minimal_plots_args) \
    @(h5_file)

#    --fit_redshift_mu_term \
