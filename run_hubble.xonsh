#!/usr/bin/env xonsh

from pathlib import Path

# Optional interactive prompt customization is intentionally omitted so this
# batch runner does not depend on the external ``cmd_done`` xontrib.

# Environment variables (xonsh style)
$QT_QPA_PLATFORM = "offscreen"
$NUM_CORES = __xonsh__.env.get("NUM_CORES", "30")
$PYTHONPATH = str(Path(__file__).resolve().parent / "src")
$MPLCONFIGDIR = "/tmp/qvc-matplotlib"
$SHEN_PUBTOOLS_PATH = __xonsh__.env.get(
    "SHEN_PUBTOOLS_PATH",
    str(Path.home() / "sdev" / "quasarlf" / "pubtools"),
)

# Completeness settings are passed explicitly to the scientific CLI.
import sys
sys.path.insert(0, str(Path(__file__).resolve().parent / "src"))
from qvc.hubble.completeness_grid import launcher_completeness_options
completeness_grid_options = launcher_completeness_options(
    __xonsh__.env.get("ARGS", [])[1:],
    {
        "QVC_HUBBLE_COMPLETENESS_MAG_BIN_WIDTH": "0.2",
        "QVC_HUBBLE_COMPLETENESS_Z_BIN_WIDTH": "0.2",
        "QVC_HUBBLE_COMPLETENESS_SMOOTH_SIGMA_MAG": "0.10",
        "QVC_HUBBLE_COMPLETENESS_SMOOTH_SIGMA_Z": "0.30",
    },
)
completeness_mag_bin_width = completeness_grid_options["QVC_HUBBLE_COMPLETENESS_MAG_BIN_WIDTH"]
completeness_z_bin_width = completeness_grid_options["QVC_HUBBLE_COMPLETENESS_Z_BIN_WIDTH"]
completeness_smooth_sigma_mag = completeness_grid_options["QVC_HUBBLE_COMPLETENESS_SMOOTH_SIGMA_MAG"]
completeness_smooth_sigma_z = completeness_grid_options["QVC_HUBBLE_COMPLETENESS_SMOOTH_SIGMA_Z"]

# Speed options: fastest, quick, medium, standard, production.
# Set QVC_HUBBLE_SPEED=medium for 100 initial live points, batches of 50,
# and a 2,000 effective-sample target (Dynesty). Runtime is model-dependent.
# Environment overrides support isolated, reproducible cut-search members.
speed = __xonsh__.env.get("QVC_HUBBLE_SPEED", "standard")

magnitude_convention = __xonsh__.env.get("QVC_HUBBLE_MAGNITUDE_CONVENTION", "dereddened")
completeness_magnitude = __xonsh__.env.get(
    "QVC_HUBBLE_COMPLETENESS_MAGNITUDE", "attenuated"
)
completeness_magnitude_support_mode = str(
    __xonsh__.env.get("QVC_HUBBLE_COMPLETENESS_MAGNITUDE_SUPPORT_MODE", "hard-cut")
).strip().lower()
if completeness_magnitude_support_mode not in {"tails", "hard-cut"}:
    raise ValueError(
        "QVC_HUBBLE_COMPLETENESS_MAGNITUDE_SUPPORT_MODE must be tails or hard-cut; "
        f"got {completeness_magnitude_support_mode!r}."
    )
completeness_lf_model = __xonsh__.env.get(
    "QVC_HUBBLE_COMPLETENESS_LF_MODEL", "wang2026_type1_lade_a"
)
cut_tier = str(__xonsh__.env.get("QVC_HUBBLE_CUT_TIER", "2")).strip().lower()
if cut_tier not in {"none", "0", "1", "2"}:
    raise ValueError(
        "QVC_HUBBLE_CUT_TIER must be one of: none, 0, 1, 2; "
        f"got {cut_tier!r}."
    )
light_curve_uncertainty_mode = str(
    __xonsh__.env.get("QVC_HUBBLE_LIGHT_CURVE_UNCERTAINTY_MODE", "covariance")
).strip().lower()
if light_curve_uncertainty_mode not in {"covariance", "posterior-draws"}:
    raise ValueError(
        "QVC_HUBBLE_LIGHT_CURVE_UNCERTAINTY_MODE must be covariance or "
        f"posterior-draws; got {light_curve_uncertainty_mode!r}."
    )

# Hubble quality-cut thresholds. Edit the defaults here, or override any one
# with the corresponding environment variable. Use "none" for thresholds that
# are optional; the Tier 1 chi-square and R-hat limits must stay numeric.
cut_threshold_defaults = {
    # Tier 0: inclusive limits in the selected completeness magnitude
    # (attenuated by default). Defaults select the 17–24 magnitude range.
    "QVC_CUT_COMPLETENESS_MAG_2500_MIN": "17",
    "QVC_CUT_COMPLETENESS_MAG_2500_MAX": "24",
    # Tier 1: spectral/light-curve fit quality and convergence.
    "QVC_CUT_JAXSEDFIT_JOINT_REDUCED_CHI2_MAX": "1.2", # they all pass
    "QVC_CUT_SED_REDUCED_CHI2_MAX": "1.5",
    "QVC_CUT_SPECTROSCOPY_REDUCED_CHI2_MAX": "1.1",
    "QVC_CUT_LOO_CHI2_EFF_MAX": "1.0",
    "QVC_CUT_SPECTRAL_RHAT_MAX": "1.1",
    "QVC_CUT_LIGHT_CURVE_RHAT_MAX": "1.05",
    "QVC_CUT_NUM_DIVERGENCES_MAX": "0",
    # Tier 2: fitted-parameter and science-quality cuts.
    "QVC_CUT_LOG_TAU_UV_RF_MIN": "1.3",
    "QVC_CUT_T_RF_LENGTH_MIN": "none",
    "QVC_CUT_LIGHT_CURVE_N_POINTS_MIN": "none",
    "QVC_CUT_SN_MEDIAN_ALL_MIN": "3",
    "QVC_CUT_ETA_SIGMA_KL_MIN": "none",
    "QVC_CUT_LOG_TAU_UV_RF_MAX": "none",
    "QVC_CUT_T_RF_OVER_TAU_UV_RF_MIN": "none",
    "QVC_CUT_APPARENT_MAG_2500_ERR_MAX": "none",
    "QVC_CUT_F_BC_3000_MAX": "none",
    "QVC_CUT_F_FE_UV_3000_MAX": "none",
    "QVC_CUT_F_HOST_2500_PSF_MAX": "none",
    "QVC_CUT_A_2500_TOTAL_MAX": "none",
    "QVC_CUT_EBV_GAL_PLUS_EBV_AGN_MAX": "none",
    "QVC_CUT_LOW_L2500_FHOST_LOG_L_MAX": "none",
    "QVC_CUT_LOW_L2500_FHOST_PSF_MAX": "none",
}
cut_thresholds = {}
for name, default in cut_threshold_defaults.items():
    value = str(__xonsh__.env.get(name, default)).strip()
    __xonsh__.env[name] = value
    cut_thresholds[name] = value

resume_checkpoint = __xonsh__.env.get("QVC_HUBBLE_RESUME", "")
resume_args = ["--resume", resume_checkpoint] if resume_checkpoint else []


#h5_file = "results/data/aug18_0955pm_erlang_preview_chisq_nofluxguard_n8000_ebdef2a_chisq.h5"
#spectra_fit_csv = "results/data/jul29_2206_9dad47e_sedfit.csv"
#spectra_fit_csv = "results/data/aug17_0205pm_spectrafit_090df0c_nested_N8000.csv"
#spectra_fit_csv = "results/data/jaxqsofit/aug24_0152pm_spectrafit_e5d2897_chisqgt20_N8000_nested_fhostpsf_resumed_m2500norm12_v3.h5"
#spectra_fit_csv = "results/data/jaxqsofit/aug28_0111pm_spectrafit_f6a63a3_chisqgt20_N8000_nested_fhostpsf_delayedburst_galexauto.h5"
#spectra_fit_csv = "results/data/jaxqsofit/aug29_0315pm_spectrafit_dc35f3a_chisqgt20_N8000_nested_fhostpsf_delayedburst_galexauto_fixed.h5"
#
#spectra_fit_csv = "results/data/jaxqsofit/aug31_1159pm_spectrafit_af65bbe_chisqgt20_N8000_nested_fhostpsf_delayedburst_morebands_bal.h5"
spectra_fit_csv = "results/data/jaxqsofit/aug31_w500s500_d01c034.h5"

#spectra_fit_csv = "results/data/jaxqsofit/aug31_1159pm_spectrafit_af65bbe_chisqgt20_N8000_nested_fhostpsf_delayedburst_morebands_bal_intersection.h5"
#spectra_fit_csv = "results/data/jaxqsofit/sep03_1231am_spectrafit_d01c034_chisqgt20_N8000_nested_fhostpsf_delayedburst_morebands_bal_w2000s1000_intersection.h5"

#h5_file = "results/data/aug16_0611am_mag_linear_svi4000w2000s500_f978995_stone.h5"
#h5_file = "results/dat"a/aug27_1219pm_erlang_legacy_svithennuts_psflogitnormal_iters3_svi4000w250s250_stonechisq_specaug240152pmv3_n8000_536f607_chisq.h5"
#h5_file = "results/data/aug27_1219pm_erlang_legacy_svithennuts_psflogitnormal_iters3_svi4000w250s250_stonechisq_specaug240152pmv3_n8000_536f607_chisq.h5"
#h5_file = "results/data/aug29_0158am_erlang_dho_svithennuts_psflogitnormal_iters1_svi10000lr0003w250s100_stonechisq_specaug280111pm_n8000_ce36392_chisq.h5"
#h5_file = "results/data/aug30_0117am_slb_svithennuts_psflogitnormal_iters1disk3_svi10000lr0003w250s250_stonechisq_specaug280111pm_n8000_dc35f3a_chisq_all.h5"
#h5_file = "results/data/aug30_0404pm_slb_seeing_svithennuts_psflogitnormal_iters1disk3_svi10000lr0003w250s250_dc35f3a_chisq.h5"
#h5_file = "results/data/aug30_0849pm_slb_seeing_etapriormodified_svithennuts_psflogitnormal_iters1disk3_svi10000lr0003w250s250_1ab99b5_chisq.h5"
#h5_file = "results/data/aug31_1245am_slb_seeing_etapriormodifiedsigma_noetatau_svithennuts_psflogitnormal_iters1disk3_svi10000lr0003w250s250_c258734_chisq.h5"

#h5_file = "results/data/aug31_1219pm_slb_seeing_etapriormodifiewided_noetatau_svithennuts_iters2disk3_svi10000lr0003w250s250_5567ce3_chisq.h5"
#h5_file = "results/data/sep02_1059am_slb_seeing_etapriormodifiewided_noetatau_svithennuts_iters2disk3_svi10000lr0003w250s250_specaug311159pm_d01c034_chisq.h5"

#h5_file = 'results/data/sep06_0744pm_slb_seeing_etapriormodifiewided_noetatau_svithennuts_iters3disk3_svi10000lr0003w1000s500_specaug31w500s500_d01c034_chisq.h5'

#h5_file = 'results/data/sep08_1206am_chisq_slb_faster_etamodified_n2000_iters3disk3_svi10000lr0003w500s250_specaug31w500s250_6c83c0c_chisq.h5'
#h5_file = 'results/data/sep08_1207am_chisq_slb_faster_etamodifiedtight_n2000_iters3disk3_svi10000lr0003w500s250_specaug31w500s250_5203856_chisq_with_timescales.h5'
#h5_file = 'results/data/sep08_0914am_chisq_slb_faster_etadmodified_n2000_iters3disk3_svi10000lr0003w500s250_specaug31w500s250_83cb31d_chisq_with_timescales.h5'

#h5_file = "results/data/sep08_1244pm_chisq_slb_faster_etamodifiedtight_n8000excn2000_iters3disk3_svi10000lr0003w500s250_specaug31w500s250_83cb31d_chisq.h5"

h5_file = "results/data/sep09_1033am_chisq_slb_faster_etamodifiedtight_nallexcn8000and2000_iters3disk3_svi10000lr0003w500s250_specaug31w500s250_83cb31d_chisq.h5"

$PREFIX = __xonsh__.env.get(
    "QVC_HUBBLE_PREFIX",
    f"sep14a_tau13cut_slb_bsc01m02_merrnone_magcut1724_cs02020103_chisq20_wang_specw500s500_h5sep091033_tier{cut_tier}_{speed}",
)

prefix = $PREFIX
echo "Running hubble_fit.py and PREFIX=" $PREFIX
echo "Using cumulative Hubble cut tier:" @(cut_tier)
echo "Using light-curve uncertainty mode:" @(light_curve_uncertainty_mode)
echo "Using completeness magnitude support mode:" @(completeness_magnitude_support_mode)
echo "Using Hubble cut thresholds:"
for name, value in cut_thresholds.items():
    echo "  " @(name) "=" @(value)

python -m qvc.hubble.hubble_fit \
    @(resume_args) \
    --bright-subsample-completeness-min 0.1 --bright-subsample-margin 0.2 \
    --cosmo_models FlatLambdaCDM Flatw0waCDM \
    --run single \
    --speed @(speed) \
    --spectra_fit_csv @(spectra_fit_csv) \
    --magnitude-convention @(magnitude_convention) \
    --completeness_magnitude @(completeness_magnitude) \
    --completeness-magnitude-support-mode @(completeness_magnitude_support_mode) \
    --completeness_lf_model @(completeness_lf_model) \
    --completeness-mag-bin-width @(completeness_mag_bin_width) \
    --completeness-z-bin-width @(completeness_z_bin_width) \
    --completeness-smooth-sigma-mag @(completeness_smooth_sigma_mag) \
    --completeness-smooth-sigma-z @(completeness_smooth_sigma_z) \
    --light-curve-uncertainty-mode @(light_curve_uncertainty_mode) \
    --cut-tier @(cut_tier) \
    --result_prefix "fiducial" \
    --z_range 0.44 3.16 \
    --prefix @(prefix) \
    --disable_sigma_clip_pass \
    --sigma_clip_threshold 3.0 \
    --prior-profile centered_lcdm \
    --skip-debiased-residual-plot \
    @(h5_file)

#    --bright-subsample-completeness-min 0.1 --bright-subsample-margin 0.25 \

# --minimal-plots
#    --plot-completeness \

# QVC_HUBBLE_CUT_TIER meanings (tiers are cumulative):
#   none: no tiered cuts; 0: eligibility only; 1: tiers 0+1; 2: tiers 0+1+2

bash scripts/copy_paper_assets.sh --speed @(speed) --fiducial-dir @(str(Path("plots/hubble") / prefix))
