#!/usr/bin/env xonsh

from pathlib import Path

# Optional interactive prompt customization is intentionally omitted so this
# batch runner does not depend on the external ``cmd_done`` xontrib.

# Environment variables (xonsh style)
$QT_QPA_PLATFORM = "offscreen"
$NUM_CORES = __xonsh__.env.get("NUM_CORES", "30")
$PYTHONPATH = str(Path(__file__).resolve().parent / "src")
$MPLCONFIGDIR = "/tmp/qvc-matplotlib"
$SHEN_PUBTOOLS_PATH = __xonsh__.env.get(
    "SHEN_PUBTOOLS_PATH",
    str(Path.home() / "sdev" / "quasarlf" / "pubtools"),
)

# Hubble quality cuts used for the conservative completeness-smoothing test.
# Keep the category-specific R-hat variables: QVC_CUT_MCMC_RHAT_MAX has been
# retired and is intentionally not used here.
$QVC_CUT_SPECTRAL_RHAT_MAX = "1.20"
$QVC_CUT_LIGHT_CURVE_RHAT_MAX = "1.05"
$QVC_CUT_LOG_TAU_UV_RF_MAX = "2.8"
$QVC_CUT_APPARENT_MAG_2500_ERR_MAX = "0.30"
$QVC_CUT_JAXSEDFIT_JOINT_REDUCED_CHI2_MAX = "1.30"

# Conservative 2D completeness-map smoothing (mag, z).  These override the
# shared defaults for this runner and match the retained Hubble-diagram test.
$QVC_HUBBLE_COMPLETENESS_SMOOTH_SIGMA_MAG = "0.10"
$QVC_HUBBLE_COMPLETENESS_SMOOTH_SIGMA_Z = "0.30"

# Previous relaxed thresholds; uncomment the relevant line above and comment
# its active counterpart to quickly restore it for a comparison run.
# $QVC_CUT_LIGHT_CURVE_RHAT_MAX = "1.10"
# $QVC_CUT_LOG_TAU_UV_RF_MAX = "4.0"
# $QVC_CUT_APPARENT_MAG_2500_ERR_MAX = "1.0"
# $QVC_CUT_JAXSEDFIT_JOINT_REDUCED_CHI2_MAX = "1.5"
# $QVC_CUT_A_2500_TOTAL_MAX = "0.25"
# $QVC_HUBBLE_COMPLETENESS_SMOOTH_SIGMA_MAG = "0.20"
# $QVC_HUBBLE_COMPLETENESS_SMOOTH_SIGMA_Z = "0.20"

# Sweep values fastest, quick, standard.  The environment overrides make this
# runner suitable for isolated, reproducible cut-search members.
speed = __xonsh__.env.get("QVC_HUBBLE_SPEED", "quick")
magnitude_convention = __xonsh__.env.get("QVC_HUBBLE_MAGNITUDE_CONVENTION", "dereddened")
completeness_magnitude = __xonsh__.env.get(
    "QVC_HUBBLE_COMPLETENESS_MAGNITUDE", "attenuated"
)
resume_checkpoint = __xonsh__.env.get("QVC_HUBBLE_RESUME", "")
resume_args = ["--resume", resume_checkpoint] if resume_checkpoint else []
no_cuts = __xonsh__.env.get("QVC_HUBBLE_NO_CUTS", "false").lower() in {
    "1", "true", "yes", "on"
}
no_cuts_args = ["--no-cuts"] if no_cuts else []
minimal_plots = __xonsh__.env.get("QVC_HUBBLE_MINIMAL_PLOTS", "false").lower() in {
    "1", "true", "yes", "on"
}
minimal_plots_args = ["--minimal-plots"] if minimal_plots else []

h5_file = "results/data/lc_data_all.h5"

#h5_file = "results/data/lc_data_all_aug06_0115_f2b677d_N4000_BOSS_20260817.h5"
#h5_file = "results/data/aug17_0501am_erlang_preview_chisq_legacy_n4000_boss_f2b677d_chisq.h5"
#spectra_fit_h5 = "results/data/jul29_2206_9dad47e_sedfit.h5"

#h5_file = "results/data/aug18_0955pm_erlang_preview_chisq_nofluxguard_n8000_ebdef2a_chisq.h5"
#spectra_fit_h5 = "results/data/jul29_2206_9dad47e_sedfit.h5"
#spectra_fit_h5 = "results/data/aug17_0205pm_spectrafit_090df0c_nested_N8000.h5"
#h5_file = "results/data/aug16_0611am_mag_linear_svi4000w2000s500_f978995_stone.h5"

#spectra_fit_h5 = "results/data/aug20_0955am_spectrafit_1738e97_stone_svi4000lr001w500s250_chunk1.h5"
#h5_file = "results/data/aug19_1037pm_mag_linear_svi4000w2000s500_c3ce4ce_stone_nolinear.h5"

spectra_fit_h5 = "results/data/aug21_0827am_spectrafit_9b14caf_nested_N8000_rhat.h5"
h5_file = "results/data/aug22_0346pm_mag_linear_svi4000w2000s500_stonechisq_specaug210827am_n8000_af3ff4c_chisq.h5"


$PREFIX = __xonsh__.env.get(
    "QVC_HUBBLE_PREFIX",
    f"aug22b_dereddened_nocutsrelaxed_fixedzcompletenessrange_h5aug0346pmmaglinear_specaug210827am_newcuts_newbins_n8000_{speed}",
)

prefix = $PREFIX
echo "Running hubble_fit.py and PREFIX=" $PREFIX

python -m qvc.hubble.hubble_fit \
    @(resume_args) \
    --cosmo_models Flatw0waCDM \
    --run single \
    --speed @(speed) \
    --spectra_fit_h5 @(spectra_fit_h5) \
    --magnitude-convention @(magnitude_convention) \
    --completeness_magnitude @(completeness_magnitude) \
    --result_prefix "fiducial" \
    --z_range 0.44 3.16 \
    --prefix @(prefix) \
    --disable_sigma_clip_pass \
    --sigma_clip_threshold 3.0 \
    --completeness-closure-test \
    @(no_cuts_args) \
    @(minimal_plots_args) \
    @(h5_file)
