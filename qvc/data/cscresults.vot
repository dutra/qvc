<VOTABLE version="1.2"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://www.ivoa.net/xml/VOTable/v1.2"
  xsi:schemaLocation="http://www.ivoa.net/xml/VOTable/v1.2 http://www.ivoa.net/xml/VOTable/v1.2"
  xmlns:stc="http://www.ivoa.net/xml/STC/v1.30">
<RESOURCE name="CSC">
<TABLE name="null">
<FIELD ID="col0" datatype="int" name="usrid" ucd="meta.id" width="7">
<DESCRIPTION>User Table identifier</DESCRIPTION>
<VALUES null='-2147483648'/>
</FIELD>
<FIELD ID="col1" datatype="double" name="separation" precision="F2" ucd="pos.angDistance" unit="arcsec" width="9">
<DESCRIPTION>Distance from master source to user source</DESCRIPTION>
</FIELD>
<FIELD ID="col2" datatype="double" name="probability" precision="F2" ucd="stat.probability" width="9">
<DESCRIPTION>Probability that master source and user source are a match</DESCRIPTION>
</FIELD>
<FIELD ID="col3" arraysize="*" datatype="char" name="name" width="22">
<DESCRIPTION>Source name in the format '2CXO Jhhmmss.s{+|-}ddmmss[X]'</DESCRIPTION>
</FIELD>
<FIELD ID="col4" datatype="double" name="ra" ucd="pos.eq.ra;meta.main">
<DESCRIPTION>Source position, ICRS right ascension</DESCRIPTION>
</FIELD>
<FIELD ID="col5" datatype="double" name="dec" ucd="pos.eq.dec;meta.main">
<DESCRIPTION>Source position, ICRS declination</DESCRIPTION>
</FIELD>
<FIELD ID="col6" datatype="double" name="err_ellipse_r0" precision="F2" unit="arcsec">
<DESCRIPTION>Major radius of the 95% confidence level position error ellipse</DESCRIPTION>
</FIELD>
<FIELD ID="col7" datatype="double" name="err_ellipse_r1" precision="F2" unit="arcsec">
<DESCRIPTION>Minor radius of the 95% confidence level position error ellipse</DESCRIPTION>
</FIELD>
<FIELD ID="col8" datatype="double" name="err_ellipse_ang" precision="F1" unit="deg">
<DESCRIPTION>Position angle (ref. local true north) of the major axis of the 95% confidence level error ellipse</DESCRIPTION>
</FIELD>
<FIELD ID="col9" datatype="double" name="significance" precision="F2">
<DESCRIPTION>Highest flux significance (S/N) across all stacked observations and energy bands</DESCRIPTION>
</FIELD>
<FIELD ID="col10" arraysize="*" datatype="char" name="likelihood_class">
<DESCRIPTION>Highest detection likelihood classification across all stacked observations and energy bands</DESCRIPTION>
</FIELD>
<FIELD ID="col11" datatype="boolean" name="conf_flag">
<DESCRIPTION>Source may be confused (source regions overlap in one or more contributing stacked observations)</DESCRIPTION>
</FIELD>
<FIELD ID="col12" datatype="boolean" name="sat_src_flag">
<DESCRIPTION>Source is saturated in all observations; source properties are unreliable</DESCRIPTION>
</FIELD>
<FIELD ID="col13" datatype="boolean" name="streak_src_flag">
<DESCRIPTION>Source is located on an ACIS readout streak in all observations; source properties may be affected</DESCRIPTION>
</FIELD>
<FIELD ID="col14" datatype="double" name="flux_aper_b" precision="E3" unit="erg/s/cm^2">
<DESCRIPTION>Aperture-corrected net energy flux inferred from the source region aperture, best estimate derived from the longest block of a multi-band, flux-ordered Bayesian Block analysis of the contributing observations, and calculated by counting X-ray events; ACIS broad (0.5-7.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col15" datatype="double" name="flux_aper_lolim_b" precision="E3" unit="erg/s/cm^2">
<DESCRIPTION>Aperture-corrected net energy flux inferred from the source region aperture, best estimate derived from the longest block of a multi-band, flux-ordered Bayesian Block analysis of the contributing observations, and calculated by counting X-ray events (68% lower confidence limit); ACIS broad (0.5-7.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col16" datatype="double" name="flux_aper_hilim_b" precision="E3" unit="erg/s/cm^2">
<DESCRIPTION>Aperture-corrected net energy flux inferred from the source region aperture, best estimate derived from the longest block of a multi-band, flux-ordered Bayesian Block analysis of the contributing observations, and calculated by counting X-ray events (68% upper confidence limit); ACIS broad (0.5-7.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col17" datatype="double" name="flux_aper_w" precision="E3" unit="erg/s/cm^2">
<DESCRIPTION>Aperture-corrected net energy flux inferred from the source region aperture, best estimate derived from the longest block of a multi-band, flux-ordered Bayesian Block analysis of the contributing observations, and calculated by counting X-ray events; HRC wide (~0.1-10.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col18" datatype="double" name="flux_aper_lolim_w" precision="E3" unit="erg/s/cm^2">
<DESCRIPTION>Aperture-corrected net energy flux inferred from the source region aperture, best estimate derived from the longest block of a multi-band, flux-ordered Bayesian Block analysis of the contributing observations, and calculated by counting X-ray events (68% lower confidence limit); HRC wide (~0.1-10.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col19" datatype="double" name="flux_aper_hilim_w" precision="E3" unit="erg/s/cm^2">
<DESCRIPTION>Aperture-corrected net energy flux inferred from the source region aperture, best estimate derived from the longest block of a multi-band, flux-ordered Bayesian Block analysis of the contributing observations, and calculated by counting X-ray events (68% upper confidence limit); HRC wide (~0.1-10.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col20" datatype="double" name="flux_aper_avg_b" precision="E3" unit="erg/s/cm^2">
<DESCRIPTION>Aperture-corrected net energy flux inferred from the source region aperture, averaged over all contributing observations, and calculated by counting X-ray events; ACIS broad (0.5-7.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col21" datatype="double" name="flux_aper_avg_lolim_b" precision="E3" unit="erg/s/cm^2">
<DESCRIPTION>Aperture-corrected net energy flux inferred from the source region aperture, averaged over all contributing observations, and calculated by counting X-ray events (68% lower confidence limit); ACIS broad (0.5-7.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col22" datatype="double" name="flux_aper_avg_hilim_b" precision="E3" unit="erg/s/cm^2">
<DESCRIPTION>Aperture-corrected net energy flux inferred from the source region aperture, averaged over all contributing observations, and calculated by counting X-ray events (68% upper confidence limit); ACIS broad (0.5-7.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col23" datatype="double" name="flux_aper_avg_w" precision="E3" unit="erg/s/cm^2">
<DESCRIPTION>Aperture-corrected net energy flux inferred from the source region aperture, averaged over all contributing observations, and calculated by counting X-ray events; HRC wide (~0.1-10.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col24" datatype="double" name="flux_aper_avg_lolim_w" precision="E3" unit="erg/s/cm^2">
<DESCRIPTION>Aperture-corrected net energy flux inferred from the source region aperture, averaged over all contributing observations, and calculated by counting X-ray events (68% lower confidence limit); HRC wide (~0.1-10.0 keV) energy band</DESCRIPTION>
</FIELD>
<FIELD ID="col25" datatype="double" name="flux_aper_avg_hilim_w" precision="E3" unit="erg/s/cm^2">
<DESCRIPTION>Aperture-corrected net energy flux inferred from the source region aperture, averaged over all contributing observations, and calculated by counting X-ray events (68% upper confidence limit); HRC wide (~0.1-10.0 keV) energy band</DESCRIPTION>
</FIELD>
