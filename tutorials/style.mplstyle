font.size: 22

axes.linewidth: 2.5
axes.facecolor: 'white'
legend.fontsize: 18
axes.titlesize: 20
axes.labelsize: 18

xtick.major.width: 2.5
xtick.major.size: 8
xtick.minor.size: 4
xtick.labelsize: 18
xtick.minor.visible: True
xtick.direction: in
xtick.top: True
xtick.minor.width: 2
xtick.major.top: True

ytick.major.width: 2.5
ytick.major.size: 8
ytick.minor.size: 4
ytick.labelsize: 18
ytick.minor.visible: True
ytick.direction: in
ytick.right: True
ytick.minor.width: 2
ytick.major.right: True

figure.titlesize: 22
figure.figsize: 10,8


lines.linewidth: 2
errorbar.capsize: 4
lines.markersize: 4
#image.cmap: RdBu_r

savefig.facecolor: 'white'
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.2
text.usetex: False
